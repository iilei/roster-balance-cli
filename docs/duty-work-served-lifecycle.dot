digraph duty_work_served_lifecycle {
  graph [rankdir=LR, bgcolor="transparent", margin=0.05, pad=0.1, nodesep=0.25, ranksep=0.35]
  node [shape=box, style="rounded,filled", fontname=" sans", fontsize=11, color="#334155", fontcolor="#0f172a", margin="0.16,0.1"]
  edge [color="#64748b", penwidth=1.5, arrowsize=0.7, fontname=" sans", fontsize=9, fontcolor="#475569"]

  start [label="impact starts\n100%", fillcolor="#dbeafe"]
  hold [label="hold_duration\n48 hours", fillcolor="#e0f2fe"]
  decay [label="front-loaded\ndecay profile", fillcolor="#fef3c7"]
  end [label="irrelevant_after\n336 hours\nimpact = 0", fillcolor="#dcfce7"]

  start -> hold [label="unchanged"]
  hold -> decay [label="transition"]
  decay -> end [label="irrelevant"]
}
