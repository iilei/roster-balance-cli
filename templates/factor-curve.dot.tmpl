digraph factor_lifecycles {
  graph [bgcolor="transparent", compound=true, overlap=false, outputorder=edgesfirst]
  node [color="#cc0256a2", fontcolor="#0f172a", fontname=" sans", fontsize=10]
  edge [color="#d85e91", fontname=" sans", fontsize=9, arrowhead=none]

{{ $config := datasource "config" }}
{{ range $index, $factor := $config.factors }}
  subgraph cluster_{{ $index }} {
    label={{ printf "%q" $factor.name }}
    color="#cbd5e1"
    labelloc="t"

    origin_{{ $index }} [shape=point, width=0.001, style=invis, pos="0,0!"]
    xaxis_end_{{ $index }} [shape=point, width=0.001, style=invis, pos="520,0!"]
    yaxis_end_{{ $index }} [shape=point, width=0.001, style=invis, pos="0,270!"]
    origin_{{ $index }} -> xaxis_end_{{ $index }} [color="#0f172a", penwidth=1, arrowhead=normal, arrowsize=0.5]
    origin_{{ $index }} -> yaxis_end_{{ $index }} [color="#0f172a", penwidth=1, arrowhead=normal, arrowsize=0.5]

    axis_x_{{ $index }} [label="time", shape=none, fontsize=9, pos="536,-4!"]
    axis_y_{{ $index }} [label="impact", shape=none, fontsize=9, pos="-20,282!"]

{{- $l1 := $factor.name }}
{{- $l2 := printf "reference: %s" $factor.lifecycle.curve.reference }}
{{- $l3 := printf "description: %s" $factor.lifecycle.curve.description }}
{{- $l4 := printf "source: %s" $factor.lifecycle.curve.source }}
{{- $l5 := printf "hold_duration: %v h" $factor.lifecycle.hold_duration_hours }}
{{- $l6 := printf "irrelevant_after: %v h" $factor.lifecycle.irrelevant_after_hours }}
{{- $maxLen := len $l1 }}
{{- range (coll.Slice $l2 $l3 $l4 $l5 $l6) }}
  {{- if gt (len .) $maxLen }}{{ $maxLen = len . }}{{ end }}
{{- end }}
{{- $boxWidthPt := math.Sub (math.Add (math.Mul $maxLen 5.5) 18.0) 60 }}
{{- $leftOffsetPt := 3.0 }}
{{- $posX := math.Add $leftOffsetPt (math.Div $boxWidthPt 2.0) }}

    info_{{ $index }} [
      label={{ printf "\"%s\\lreference: %s\\ldescription: %s\\lsource: %s\\lhold_duration: %v h\\lirrelevant_after: %v h\\l\"" $factor.name $factor.lifecycle.curve.reference $factor.lifecycle.curve.description $factor.lifecycle.curve.source $factor.lifecycle.hold_duration_hours $factor.lifecycle.irrelevant_after_hours }},
      shape=box, style="filled", fillcolor="#f8fafc", color="#94a3b8", fontsize=9,
      pos="{{ $posX }},165.4!"
    ]

{{ range $pointIndex, $point := $factor.lifecycle.curve.samples }}
    curve_{{ $index }}_{{ $pointIndex }} [label="", shape=point, width=0.02, pos="{{ mul $point.x 500 }},{{ mul $point.impact 240 }}!"]
{{ if gt $pointIndex 0 }}
    curve_{{ $index }}_{{ sub $pointIndex 1 }} -> curve_{{ $index }}_{{ $pointIndex }}
{{ end }}
{{ end }}
  }
{{ end }}
}

